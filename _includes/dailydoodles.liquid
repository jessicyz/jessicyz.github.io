<div class="dailydoodles">
	{% if site.data.dailydoodles != blank %}
	<div class="row mt-3">
		{% for i in site.data.dailydoodles.doodles %}
		{% capture doodle_title %}{{i.date | date: "%B %d, %Y" }} {{i.title}}{% endcapture %}
		<div class="col-md-4 col-sm-4 mt-3 mt-md-0">
			{% include figure.liquid path=i.path
			title=doodle_title
			class="gallery img-fluid rounded z-depth-1"
			zoomable=true
			%}
			<div class="caption">
				{{ i.date | date: "%D" }}
			</div>
		</div>
		{% endfor %}
	</div>
	{% endif %}
</div>
